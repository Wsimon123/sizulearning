            </body>
          </body>
        </body>
      </body>

      <!-- RAR (Rear Right) -->
      <body name="RAR_ABAD_LINK" pos="-0.17449 -0.062 0">
        <inertial pos="0.027074453 0.015458828 0.0000094167931" quat="0.599003 0.599003 0.37576 0.37576" mass="0.45409769" diaginertia="0.000251027 0.0004874808 0.00054102144"/>
