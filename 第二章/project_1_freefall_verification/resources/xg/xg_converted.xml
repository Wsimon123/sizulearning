  <actuator>
    <motor name="FAR_ABAD" joint="FAR_ABAD_JOINT" />
    <motor name="FAR_HIP" joint="FAR_HIP_JOINT" />
    <motor name="FAR_KNEE" joint="FAR_KNEE_JOINT" />
    <motor name="FBL_ABAD" joint="FBL_ABAD_JOINT" />
    <motor name="FBL_HIP" joint="FBL_HIP_JOINT" />
    <motor name="FBL_KNEE" joint="FBL_KNEE_JOINT" />
    <motor name="RAR_ABAD" joint="RAR_ABAD_JOINT" />
    <motor name="RAR_HIP" joint="RAR_HIP_JOINT" />
    <motor name="RAR_KNEE" joint="RAR_KNEE_JOINT" />
