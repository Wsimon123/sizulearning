<mujoco model="DOG">
  <!--
    XG 四足机器人 MJCF 模型 (从 URDF 转换而来)
    此文件是从 xg.urdf 通过 MuJoCo 编译工具转换后，再手动优化得到的版本。
    
    与 xg_freefall.xml 的区别:
    - 本文件包含地面和完整碰撞体
    - 本文件使用 STL mesh 进行可视化渲染
    - xg_freefall.xml 是专门用于自由落体验证的简化版（无地面、无 mesh）
  -->

  <compiler angle="radian" meshdir="meshes"/>
  
  <option timestep="0.005" iterations="10" ls_iterations="10" solver="Newton" integrator="Euler"
          impratio="10">
    <flag contact="enable"/>
  </option>
  
  <default>
    <geom condim="3" friction="0.8 0.005 0.0001" solref="0.035 1.1" solimp="0.9 0.92 0.015"/>
    <joint damping="0.5" armature="0.01"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.3 0.3 0.3" rgb2="0.4 0.4 0.4" 
             width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" texuniform="true"/>
    <mesh name="BASE_LINK" file="BASE_LINK.STL"/>
    <mesh name="FBL_ABAD_LINK" file="FL_ABAD_LINK.STL"/>
    <mesh name="FBL_HIP_LINK" file="FL_HIP_LINK.STL"/>
    <mesh name="FBL_KNEE_LINK" file="FL_KNEE_LINK.STL"/>
    <mesh name="FL_FOOT_LINK" file="FL_FOOT_LINK.STL"/>
    <mesh name="FAR_ABAD_LINK" file="FR_ABAD_LINK.STL"/>
    <mesh name="FAR_HIP_LINK" file="FR_HIP_LINK.STL"/>
    <mesh name="FAR_KNEE_LINK" file="FR_KNEE_LINK.STL"/>
    <mesh name="FR_FOOT_LINK" file="FR_FOOT_LINK.STL"/>
    <mesh name="RAR_ABAD_LINK" file="RR_ABAD_LINK.STL"/>
    <mesh name="RAR_HIP_LINK" file="RR_HIP_LINK.STL"/>
    <mesh name="RAR_KNEE_LINK" file="RR_KNEE_LINK.STL"/>
    <mesh name="RR_FOOT_LINK" file="RR_FOOT_LINK.STL"/>
    <mesh name="RBL_ABAD_LINK" file="RL_ABAD_LINK.STL"/>
    <mesh name="RBL_HIP_LINK" file="RL_HIP_LINK.STL"/>
    <mesh name="RBL_KNEE_LINK" file="RL_KNEE_LINK.STL"/>
    <mesh name="RL_FOOT_LINK" file="RL_FOOT_LINK.STL"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="50 50 0.01" material="grid_mat"
          contype="1" conaffinity="0" priority="1" friction="1.0 0.005 0.0001" condim="3"/>
    
    <light name="ambient" mode="fixed" directional="true" 
           diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5" dir="0 0 -1"/>
    <light name="spotlight" mode="targetbodycom" target="torso"
           diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" pos="0 -3 4" cutoff="45"/>

    <body name="torso" pos="0 0 0.4">
      <inertial pos="0.0054244583 -0.00036330247 0.0060908623" quat="1.0 0.0 0.0 0.0"
          mass="6.2683759"
          diaginertia="0.027359128 0.084984679 0.099223551" />
      <freejoint />
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="BASE_LINK"/>
      <geom name="torso_collision" type="sphere" size="0.12" pos="0 0 0" contype="1" conaffinity="1" group="3" rgba="0.75294 0.75294 0.75294 0"/>

      <!-- FAR (Front Right) -->
