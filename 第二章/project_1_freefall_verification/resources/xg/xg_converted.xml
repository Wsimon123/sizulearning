        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="RAR_ABAD_LINK"/>
        <body name="RAR_HIP_LINK" pos="0 -0.0974 0">
