            <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.49804 0.49804 0.49804 1" mesh="FBL_KNEE_LINK"/>
            <body name="FBL_FOOT_LINK" pos="0 0 -0.21366">
